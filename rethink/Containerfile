# Source is public fork main as verified on 2026-11-11; not a local checkout.
FROM docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS build
WORKDIR /app
RUN wget -qO /tmp/source.tar.gz https://github.com/martinemde/rethink/archive/e96ae725850019c59547c360ec757957b9fa9ddb.tar.gz \
    && echo "e2bb72b44dc78c24d27dfc72a36b02da9e4e33f8e12dd4ba2f8d12e2af4cf0ef  /tmp/source.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /app \
    && rm /tmp/source.tar.gz
RUN apk add --no-cache nodejs npm
RUN npm ci --ignore-scripts
ENV GIT_REVISION=e96ae725850019c59547c360ec757957b9fa9ddb
RUN npm test && npm run build && npm prune --omit=dev --ignore-scripts

FROM docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS runtime
LABEL io.github.martinemde.rethink.revision="e96ae725850019c59547c360ec757957b9fa9ddb"
WORKDIR /app
RUN apk add --no-cache nodejs ca-certificates \
    && addgroup -S app && adduser -S -G app app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/config.jsonc /app/config.json
RUN mkdir -p /app/data
EXPOSE 443 8883 1884 46030 47878 44401
CMD ["sh", "-c", "if [ -n \"$RETHINK_HASSIO_OPTIONS\" ]; then exec node dist/rethink-cloud.js; fi; [ -f /app/data/config.json ] || cp /app/config.json /app/data/config.json; exec node dist/rethink-cloud.js /app/data/config.json"]
