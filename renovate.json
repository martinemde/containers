{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>martinemde/renovate-config#v1.0.0"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "renovate-config",
    "custom.regex"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Containerfile$/"
    ]
  },
  "automerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^nui/Containerfile$/"
      ],
      "matchStrings": [
        "ARG NUI_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "nats-nui/nui",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ]
}
